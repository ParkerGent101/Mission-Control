# Copy this file to .env and fill in your values.
# Mission Control is a personal finance app: the Google Sheet is the record and
# the Rocket Money CSV export in Drive is the feed. There is no LLM API key —
# the Claude agent was removed on 2026-08-30.

# ── Google Drive / Sheets ───────────────────────────────────────────────────
# Download OAuth credentials from Google Cloud Console -> APIs -> Credentials.
# Use an OAuth 2.0 Client ID for a Desktop app and save it as data/credentials.json.
# After the first auth the refresh token is cached at data/drive_token.json, and
# the Sheet/folder IDs you set in Settings are stored in data/drive_config.json.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_PROJECT_ID=mission-control-496004

# The finance workbook — one tab per month.
FINANCE_SHEET_ID=
# Who the year-rollover shares a newly generated finance file with (optional).
FINANCE_OWNER_EMAIL=

# Drive folder holding the Rocket Money transaction-export CSVs. Usually left
# blank here and set in Settings, which writes it to data/drive_config.json.
FINANCE_IMPORT_FOLDER=

# ── Sign-in (Google identity + MFA) ─────────────────────────────────────────
# Login uses "Sign in with Google" and reuses the OAuth client above. Add this
# redirect URI to that client in Google Cloud Console -> Credentials:
#   http://localhost:5000/api/auth/google/callback           (local dev)
#   https://<your-cloud-run-url>/api/auth/google/callback     (production)
ALLOWED_LOGIN_EMAILS=parkergent7@gmail.com
SESSION_LIFETIME_DAYS=7
# Break-glass ONLY: re-enable the legacy shared password. Leave false in
# production so the app is password-free (Google sign-in + MFA only).
ALLOW_PASSWORD_LOGIN=false
# Only read when ALLOW_PASSWORD_LOGIN=true.
DASHBOARD_PASSWORD=changeme

# ── Storage & runtime ───────────────────────────────────────────────────────
DATA_DIR=./data
# Set on Cloud Run only; locally the app reads and writes DATA_DIR directly.
GCS_BUCKET=
# Flask session signing key. Generated into Secret Manager by deploy.ps1 -Setup.
FLASK_SECRET=
